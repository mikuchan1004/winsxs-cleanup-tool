<Window x:Class="WinSxSCleanupTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSxSCleanupTool" Height="450" Width="800" Icon="/broom.ico"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="10" 
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8B0000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B22222"/>
                    <Setter Property="BorderBrush" Value="#FF6347"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        

        <UniformGrid Grid.Row="0" Columns="4" Margin="10">
            <Button x:Name="btnAnalyze" Content="분석" Height="40" Click="BtnAnalyze_Click"/>
            <Button x:Name="btnCleanup" Content="정리" Height="40" Click="BtnCleanup_Click"/>
            <Button x:Name="btnResetBase" Content="ResetBase" Height="40" Background="#8B0000" Click="BtnResetBase_Click"/>
            <Button x:Name="btnCancel" Content="취소" Height="40" IsEnabled="False"/>
        </UniformGrid>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="10">
            <Border Background="#252526" CornerRadius="10" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="실제 크기" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblActualSize" FontWeight="Bold" HorizontalAlignment="Center">
                    <Run Text="0" FontSize="26" Foreground="White"/>
                    <Run Text="GB" FontSize="16" Foreground="#888"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="10" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="예상 절감량" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblExpectedSize" FontWeight="Bold" HorizontalAlignment="Center">
            <Run Text="0" FontSize="26" Foreground="#FFD700"/>
            <Run Text="GB" FontSize="16" Foreground="#888"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Background="#252526" CornerRadius="10" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="시스템 사용량" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblSharedSize" FontWeight="Bold" HorizontalAlignment="Center">
            <Run Text="0" FontSize="26" Foreground="White"/>
            <Run Text="GB" FontSize="16" Foreground="#888"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border x:Name="brdCleanupStatus" Background="#252526" CornerRadius="10" Margin="5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="정리 권장 여부" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LblCleanupRecommended" Text="미측정" FontSize="26" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Margin="15,5" Background="#2D2D2D" CornerRadius="10">
            <RichTextBox x:Name="rtbLog" Background="Transparent" Foreground="White" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="5">
                <FlowDocument>
                    <Paragraph Foreground="Gray"> 안녕하세요! 시스템 최적화를 시작해볼까요?</Paragraph>
                </FlowDocument>
            </RichTextBox>
        </Border>

        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="pbProgress" Height="2" Background="#2D2D2D" Foreground="#FFD700" BorderThickness="0"/>

            <StatusBar Height="22" Background="#FF007ACC" Foreground="White" Padding="0">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>

                <StatusBarItem Grid.Column="0" VerticalContentAlignment="Center">
                    <TextBlock x:Name="stbStatus" Text="대기 중..." Margin="10,0" FontSize="11"/>
                </StatusBarItem>

                <StatusBarItem Grid.Column="1" Padding="0" Margin="0,0,5,0" VerticalContentAlignment="Center">
                    <Button x:Name="btnSaveLog" Content="💾 로그 저장" 
                    FontSize="11" Height="18" Padding="6,0" Margin="0"
                    Background="#FF1E1E1E" Foreground="White" BorderThickness="0" 
                    Click="BtnSaveLog_Click"/>
                </StatusBarItem>
            </StatusBar>
        </StackPanel>
    </Grid>
</Window>