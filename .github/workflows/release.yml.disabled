name: Release (Windows x64)

on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: windows-latest

    steps:
      # 1️⃣ 소스 체크아웃
      - name: Checkout
        uses: actions/checkout@v4

      # 2️⃣ .NET SDK 설정
      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      # 3️⃣ 버전 정보 추출 (태그 강제)
      - name: Extract version from tag
        id: version
        shell: pwsh
        run: |
          $tag = $env:GITHUB_REF_NAME

          if (-not $tag.StartsWith("v")) {
              Write-Error "This workflow must be triggered by a version tag (vX.Y.Z)"
          }

          $ver = $tag.TrimStart('v')
          $zip = "WinSxSCleanupTool_v$ver_win-x64.zip"

          Write-Host "Tag     : $tag"
          Write-Host "Version : $ver"
          Write-Host "ZIP     : $zip"

          echo "tag=$tag" >> $env:GITHUB_OUTPUT
          echo "version=$ver" >> $env:GITHUB_OUTPUT
          echo "zip=$zip" >> $env:GITHUB_OUTPUT

      # 4️⃣ Publish (Self-contained, Single File)
      - name: Publish
        shell: pwsh
        run: |
          dotnet publish WinSxSCleanupTool.csproj `
            -c Release `
            -r win-x64 `
            --self-contained true `
            -p:PublishSingleFile=true `
            -p:IncludeNativeLibrariesForSelfExtract=true `
            -o publish

      # 5️⃣ ZIP 생성 (버전 포함)
      - name: Create ZIP
        shell: pwsh
        run: |
          $zip = "${{ steps.version.outputs.zip }}"

          if (Test-Path $zip) {
              Remove-Item $zip -Force
          }

          Compress-Archive -Path publish\* -DestinationPath $zip

          Write-Host "::notice::Created release asset: $zip"

      # 6️⃣ GitHub Release 생성 + ZIP 업로드
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.version.outputs.tag }}
          name: WinSxS Cleanup Tool ${{ steps.version.outputs.version }}
          files: ${{ steps.version.outputs.zip }}
          generate_release_notes: false
